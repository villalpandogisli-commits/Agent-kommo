# ---- Kommo ----
# Subdominio de tu cuenta Kommo (ej. "miempresa" para miempresa.kommo.com)
KOMMO_SUBDOMAIN=
# Token de acceso de integración privada de Kommo (long-lived access token)
KOMMO_ACCESS_TOKEN=
# Secreto que TÚ inventas y validas en cada webhook del Salesbot
WEBHOOK_SECRET=un-secreto-que-inventes

# ---- Claude (Anthropic) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Supabase ----
SUPABASE_URL=
# Usa la Service Role key (backend). NUNCA la expongas en el cliente.
SUPABASE_SERVICE_KEY=

# ---- Servidor ----
PORT=3000

# ---- Escalar a humano (opcional): responsable de Kommo al que asignar ----
KOMMO_HUMAN_USER_ID=
